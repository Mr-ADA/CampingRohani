<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CampingRohani</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CampingRohani.styles.css" asp-append-version="true" />
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,300;0,400;0,700;1,700&display=swap" rel="stylesheet" />

    <!-- Feather icons -->
    <script src="https://unpkg.com/feather-icons"></script>
</head>
<body>
    <header>
        <!-- Navbar  Start-->
        <nav class="navbar">
            <a href="#" class="navbar-logo">Camping<span> Rohani</span>.</a>
            <div class="navbar-nav d-inline-block">
                <a asp-page="/Index" asp-fragment="home">Home</a>
                <a asp-page="/Index" asp-fragment="about">Tentang Kami</a>
                <a asp-page="/Index" asp-fragment="registration">Registrasi</a>
                <a asp-page="/Index" asp-fragment="contact">Kontak</a>
            </div>
            <div class="navbar-extra">
                <a href="#" id="hamburger-registration"><i data-feather="registration"></i></a>
            </div>
        </nav>
        <!-- Navbar  End-->
    </header>
    <div class="w-100 p-0">
        <main role="main" class="m-0 p-0">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-white">
        <div class="container">
            &copy; 2027 Komunitas Tritunggal Mahakudus
        </div>
        <div class="container">
            ADA - AML
        </div>
    </footer>

    <script>
        feather.replace();
    </script>
    <script src="site.js"></script>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>