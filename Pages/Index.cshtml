@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

    <!-- Hero Section Start -->
    <section class="hero w-100 p-0 m-0" id="home">
        <main class="content">
            @* Hero section is only filled with posters, replacable every year *@
        </main>
    </section>
    <!-- Hero Section End -->

    <!--   Section Start -->
    <section id="registration" class="registration align-content-center">
        <p class="subtitle text-white">Pilih Camping sesuai usiamu!</p>
        <h2><span>Daftar</span> Yuk!</h2>

        <div class="row w-auto d-inline-flex flex-row flex-nowrap justify-content-around">
            <div class="card overflow-hidden">
                <h5 class="card-header bg-warning text-white">
                    Camp SD (Kelas IV - VII)
                </h5>
                <div class="card-body bg-white text-dark">
                    <h5 class="card-title">
                        <i data-feather="calendar"></i> July 2027
                    </h5>
                    <p class="card-text">
                        With supporting text below as a natural lead-in to additional content.
                    </p>
                    <a href="#" class="btn btn-primary">Daftar!</a>
                </div>
            </div>

            <div class="card overflow-hidden">
                <h5 class="card-header bg-warning text-white">
                    Camp Siswa (Kelas VIII - XII)
                </h5>
                <div class="card-body bg-white text-dark">
                    <h5 class="card-title">
                        <i data-feather="calendar"></i> July 2027
                    </h5>
                    <p class="card-text">
                        With supporting text below as a natural lead-in to additional content.
                    </p>
                    <a href="#" class="btn btn-primary m-auto">Daftar!</a>
                </div>
            </div>

            <div class="card overflow-hidden">
                <h5 class="card-header bg-warning text-white">
                    Camp Mahasiswa dan Pekerja Muda
                </h5>
                <div class="card-body bg-white text-dark">
                    <h5 class="card-title">
                        <i data-feather="calendar"></i> July 2027
                    </h5>
                    <p class="card-text">
                        With supporting text below as a natural lead-in to additional content.
                    </p>
                    <a href="#" class="btn btn-primary">Daftar!</a>
                </div>
            </div>
        </div>
    </section>
    <!-- Registration Section End -->
